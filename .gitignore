.env
.flowus_progress_state
sync_log.txt
__pycache__/
*.pyc
# 敏感数据，包含 FlowUs 页面 UUID
books_from_flowus.json
# Git 凭据缓存（不含在 remote URL 中）
.git-creds
# 批量录入临时输入文件（用后清空，不提交）
books.txt
books.txt.bak*
# 配置变更本地备份（回滚用，不提交）
*.bak.*

# 观察记录运行时文件（含观察内容，绝不公开/不提交）
.observe/

# 项目记忆（checkpoint 含 FlowUs 页面 ID 上下文，不进公开仓库）
.memory/

# 观察系统代码 + SOP（含 FlowUs 页面 ID，绝不进公开仓库）
observe/

# 兜底保险：即使旧进程误写这两个路径，也绝不进公开仓库
progress/pending_observe.json
progress/.observe_state.json
